                  new Paragraph({ children: [new TextRun({ text: "3. _________________________________", font: "Arial", size: 20 })] }),
                ]
              }),
              new TableCell({
                borders, margins: cellMargin, width: { size: 2000, type: WidthType.DXA },
                shading: { fill: "EBF3FB", type: ShadingType.CLEAR },
                children: [
                  new Paragraph({ children: [new TextRun({ text: "Grupo:", bold: true, font: "Arial", size: 20 })] }),
                  new Paragraph({ children: [new TextRun({ text: "___________", font: "Arial", size: 20 })] }),
                  new Paragraph({ spacing: { before: 80 }, children: [new TextRun({ text: "Fecha:", bold: true, font: "Arial", size: 20 })] }),
