        spacing: { before: 60, after: 60 },
        alignment: AlignmentType.JUSTIFIED,
        children: [new TextRun({
          text: "Identificar, interpretar y aplicar los distintos tipos de cartas aeronáuticas (Aeródromo, SID, En-ruta, STAR y Aproximación) durante la planificación y ejecución de un vuelo en el simulador FSX, integrando la información que proporciona el Garmin G1000 en las pantallas PFD y MFD.",
          font: "Arial", size: 22
        })]
      }),
      spacer(),

      // ── MATERIALES ────────────────────────────────────────────────────────────
      sectionDivider("Materiales requeridos"),
      spacer(),
      bulletBold("Simulador: ", "Microsoft Flight Simulator X (FSX) — aeronave con Garmin G1000 (ej. Cessna 172 G1000 o Beechcraft Baron G1000)."),
      bulletBold("Cartas aeronáuticas: ", "SID, STAR, En-ruta (Low/High), Aproximación por instrumentos y Aeródromo. Pueden descargarse de AIP México (aeropuertos MMCU, MMCS u otro par asignado por el docente)."),
      bulletBold("Software de captura: ", "OBS Studio, Xbox Game Bar o similar para grabar el vuelo."),
      bulletBold("Procesador de texto: ", "Word, Google Docs u otro para el reporte escrito."),
      bulletBold("Bitácora de vuelo: ", "Impresa y llenada a mano durante o inmediatamente después del vuelo (ver sección 5)."),
      spacer(),

      // ── INSTRUCCIONES ────────────────────────────────────────────────────────
      sectionDivider("Instrucciones"),
      spacer(),

      heading2("Fase 1 — Planificación en tierra (antes de encender el simulador)"),
      new Paragraph({
        numbering: { reference: "numbers", level: 0 },
        spacing: { before: 60, after: 40 },
        children: [new TextRun({ text: "Descarguen e impriman las siguientes cartas para el par de aeropuertos asignado:", font: "Arial", size: 22 })]
      }),
      spacer(),
      cartasTable(),
      spacer(),
      new Paragraph({
        numbering: { reference: "numbers", level: 0 },
        spacing: { before: 60, after: 40 },
        children: [new TextRun({ text: "En la bitácora de vuelo (Sección 5), anoten previamente: aeropuerto de salida, destino, altitud de crucero planeada y ruta (airways o directo).", font: "Arial", size: 22 })]
      }),
      new Paragraph({
        numbering: { reference: "numbers", level: 0 },
        spacing: { before: 60, after: 40 },
        children: [new TextRun({ text: "Identifiquen en la Carta En-ruta al menos un VOR, una intersección y el airway que conecta origen y destino.", font: "Arial", size: 22 })]
      }),
      spacer(),

      heading2("Fase 2 — Vuelo simulado en FSX con Garmin G1000"),
      new Paragraph({
        numbering: { reference: "numbers", level: 0 },
        spacing: { before: 60, after: 40 },
        children: [new TextRun({ text: "Inicien la grabación del vuelo antes de encender los motores.", font: "Arial", size: 22 })]
      }),
      new Paragraph({
        numbering: { reference: "numbers", level: 0 },
        spacing: { before: 60, after: 40 },
        children: [new TextRun({ text: "En el FMS del G1000, ingresen el plan de vuelo completo: aeropuerto de salida → SID → En-ruta → STAR → aproximación → aeropuerto de llegada.", font: "Arial", size: 22 })]
      }),
      new Paragraph({
        numbering: { reference: "numbers", level: 0 },
        spacing: { before: 60, after: 40 },
        children: [new TextRun({ text: "Durante el vuelo, tomen capturas de pantalla en los siguientes momentos (mínimo una por momento):", font: "Arial", size: 22 })]
      }),
      bullet("Al momento de la salida: pantalla MFD mostrando el plan de vuelo activo."),
      bullet("En crucero: pantalla PFD con altitud y rumbo estabilizados."),
      bullet("Al inicio de la STAR: pantalla MFD con el procedimiento de llegada."),
      bullet("En la aproximación final: pantalla PFD con el ILS o RNAV activo."),
      bullet("Después del aterrizaje: pantalla de resumen del vuelo (si está disponible)."),
      new Paragraph({
        numbering: { reference: "numbers", level: 0 },
        spacing: { before: 60, after: 40 },
        children: [new TextRun({ text: "Terminen la grabación al apagar motores en pista.", font: "Arial", size: 22 })]
      }),
      spacer(),

      heading2("Fase 3 — Llenado de bitácora y reporte"),
      new Paragraph({
        numbering: { reference: "numbers", level: 0 },
        spacing: { before: 60, after: 40 },
        children: [new TextRun({ text: "Completen la bitácora de vuelo a mano con los datos reales del vuelo simulado (tiempos, rumbos, altitudes, observaciones).", font: "Arial", size: 22 })]
      }),
      new Paragraph({
        numbering: { reference: "numbers", level: 0 },
        spacing: { before: 60, after: 40 },
        children: [new TextRun({ text: "Elaboren un reporte escrito que incluya:", font: "Arial", size: 22 })]
      }),
      bullet("Portada con datos del equipo, grupo y fecha."),
      bullet("Descripción de cada carta utilizada: tipo, contenido relevante identificado y en qué fase del vuelo se aplicó."),
      bullet("Análisis de la pantalla PFD y MFD del G1000: ¿qué información consultaron en cada fase?"),
      bullet("Las capturas de pantalla del vuelo, debidamente etiquetadas y con una breve explicación de cada una."),
      bullet("Conclusiones del equipo sobre la importancia de las cartas aeronáuticas en la navegación real."),
      bullet("Referencias en formato APA 7ª edición."),
      spacer(),

      // ── BITÁCORA ─────────────────────────────────────────────────────────────
      sectionDivider("Bitácora de vuelo"),
      spacer(),
      body("Llenen los siguientes campos durante o inmediatamente después del vuelo simulado. Esta sección se entrega firmada a mano.", { color: "444444" }),
      spacer(),
      new Table({
        width: { size: 9360, type: WidthType.DXA },
        columnWidths: [2340, 4680, 2340],
        rows: [
          new TableRow({ children: [
            new TableCell({ borders, margins: cellMargin, shading: { fill: "EBF3FB", type: ShadingType.CLEAR }, width: { size: 2340, type: WidthType.DXA }, children: [new Paragraph({ children: [new TextRun({ text: "Aeropuerto de salida:", bold: true, font: "Arial", size: 20 })] })] }),
            new TableCell({ borders, margins: cellMargin, width: { size: 4680, type: WidthType.DXA }, children: [new Paragraph({ children: [new TextRun({ text: "", font: "Arial", size: 20 })] })] }),
            new TableCell({ borders, margins: cellMargin, shading: { fill: "EBF3FB", type: ShadingType.CLEAR }, width: { size: 2340, type: WidthType.DXA }, children: [new Paragraph({ children: [new TextRun({ text: "ICAO salida:", bold: true, font: "Arial", size: 20 })] })] }),
          ]}),
          new TableRow({ children: [
            new TableCell({ borders, margins: cellMargin, shading: { fill: "EBF3FB", type: ShadingType.CLEAR }, width: { size: 2340, type: WidthType.DXA }, children: [new Paragraph({ children: [new TextRun({ text: "Aeropuerto destino:", bold: true, font: "Arial", size: 20 })] })] }),
            new TableCell({ borders, margins: cellMargin, width: { size: 4680, type: WidthType.DXA }, children: [new Paragraph({ children: [new TextRun({ text: "", font: "Arial", size: 20 })] })] }),
            new TableCell({ borders, margins: cellMargin, shading: { fill: "EBF3FB", type: ShadingType.CLEAR }, width: { size: 2340, type: WidthType.DXA }, children: [new Paragraph({ children: [new TextRun({ text: "ICAO destino:", bold: true, font: "Arial", size: 20 })] })] }),
          ]}),
          new TableRow({ children: [
            new TableCell({ borders, margins: cellMargin, shading: { fill: "EBF3FB", type: ShadingType.CLEAR }, width: { size: 2340, type: WidthType.DXA }, children: [new Paragraph({ children: [new TextRun({ text: "Aeronave (FSX):", bold: true, font: "Arial", size: 20 })] })] }),
            new TableCell({ borders, margins: cellMargin, width: { size: 4680, type: WidthType.DXA }, children: [new Paragraph({ children: [new TextRun({ text: "", font: "Arial", size: 20 })] })] }),
            new TableCell({ borders, margins: cellMargin, shading: { fill: "EBF3FB", type: ShadingType.CLEAR }, width: { size: 2340, type: WidthType.DXA }, children: [new Paragraph({ children: [new TextRun({ text: "Hora de salida (sim):", bold: true, font: "Arial", size: 20 })] })] }),
          ]}),
          new TableRow({ children: [
            new TableCell({ borders, margins: cellMargin, shading: { fill: "EBF3FB", type: ShadingType.CLEAR }, width: { size: 2340, type: WidthType.DXA }, children: [new Paragraph({ children: [new TextRun({ text: "Altitud de crucero:", bold: true, font: "Arial", size: 20 })] })] }),
            new TableCell({ borders, margins: cellMargin, width: { size: 4680, type: WidthType.DXA }, children: [new Paragraph({ children: [new TextRun({ text: "", font: "Arial", size: 20 })] })] }),
            new TableCell({ borders, margins: cellMargin, shading: { fill: "EBF3FB", type: ShadingType.CLEAR }, width: { size: 2340, type: WidthType.DXA }, children: [new Paragraph({ children: [new TextRun({ text: "Hora de llegada (sim):", bold: true, font: "Arial", size: 20 })] })] }),
          ]}),
        ]
      }),
      spacer(),
      body("Registro de tramos:"),
      spacer(),
      bitacoraTable(),
      spacer(),
      new Table({
        width: { size: 9360, type: WidthType.DXA },
        columnWidths: [4680, 4680],
        rows: [new TableRow({ children: [
          new TableCell({ borders, margins: { top: 200, bottom: 200, left: 150, right: 150 }, width: { size: 4680, type: WidthType.DXA }, shading: { fill: "EBF3FB", type: ShadingType.CLEAR }, children: [new Paragraph({ children: [new TextRun({ text: "Firma del piloto al mando: ________________________", font: "Arial", size: 20 })] })] }),
          new TableCell({ borders, margins: { top: 200, bottom: 200, left: 150, right: 150 }, width: { size: 4680, type: WidthType.DXA }, shading: { fill: "EBF3FB", type: ShadingType.CLEAR }, children: [new Paragraph({ children: [new TextRun({ text: "Firma del copiloto: ________________________", font: "Arial", size: 20 })] })] }),
        ]})]
      }),
      spacer(),

      // ── EVALUACIÓN ────────────────────────────────────────────────────────────
      sectionDivider("Criterios de evaluación"),
      spacer(),
      rubricaTable(),
      spacer(),

      // ── ENTREGABLES ───────────────────────────────────────────────────────────
      sectionDivider("Entregables"),
      spacer(),
      new Paragraph({
        numbering: { reference: "numbers", level: 0 },
        spacing: { before: 60, after: 40 },
        children: [new TextRun({ text: "Bitácora de vuelo llenada a mano y firmada (digitalizada / fotografiada).", font: "Arial", size: 22 })]
      }),
      new Paragraph({
        numbering: { reference: "numbers", level: 0 },
        spacing: { before: 60, after: 40 },
        children: [new TextRun({ text: "Reporte escrito en PDF o Word (máx. 5 MB) con portada, análisis de cartas, capturas etiquetadas y conclusiones.", font: "Arial", size: 22 })]
      }),
      new Paragraph({
        numbering: { reference: "numbers", level: 0 },
        spacing: { before: 60, after: 40 },
        children: [new TextRun({ text: "Cartas aeronáuticas utilizadas (PDF o imagen), referenciadas en el reporte.", font: "Arial", size: 22 })]
      }),
      new Paragraph({
        numbering: { reference: "numbers", level: 0 },
        spacing: { before: 60, after: 40 },
        children: [new TextRun({ text: "Video del vuelo (mínimo 5 minutos de duración) subido a Google Drive, YouTube no listado u otra plataforma indicada por el docente. Incluir el enlace en el reporte.", font: "Arial", size: 22 })]
      }),
      spacer(),

      // ── PUNTOS A CONSIDERAR ────────────────────────────────────────────────
      sectionDivider("Puntos para considerar"),
      spacer(),
      bullet("Citen todas las fuentes consultadas en formato APA 7ª edición, incluyendo las cartas aeronáuticas descargadas."),
      bullet("El video debe mostrar claramente las pantallas del G1000; si la calidad es baja, agrega anotaciones en el reporte que expliquen lo que se ve."),
      bullet("Eviten conductas de deshonestidad académica; si usan IA para redactar, decláralo en el reporte."),
      bullet("El archivo del reporte no debe exceder 5 MB; compriman las imágenes si es necesario."),
      bullet("Revisen los criterios de evaluación antes de entregar para asegurarse de que el trabajo cumple con todos los elementos solicitados."),
      spacer(),
    ]
  }]
});

Packer.toBuffer(doc).then(buffer => {
  fs.writeFileSync("Actividad_2_U2_Cartas_Aeronauticas.docx", buffer);
  console.log("Done");
});
