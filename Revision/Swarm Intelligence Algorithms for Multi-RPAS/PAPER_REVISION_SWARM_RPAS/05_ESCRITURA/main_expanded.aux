\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Characteristics of the 33 included studies. $\dagger $ = study from systematic corpus. Val. = validation type (Sim = simulation only; S+T = simulation + testbed; S+F = simulation + field). Val. Type = Multi-agent ($\geq $2 UAVs in validation), Framework-only (multi-UAV framework validated with single agent), or Review. Metrics: T = execution time, E = energy, C = convergence. App.: Mon. = Monitoring, Spr. = Spraying, Map. = Mapping, Gen. = General coordination.}}{21}{table.4}\protected@file@percent }
\newlabel{tab:study_chars}{{4}{21}{Characteristics of the 33 included studies. $\dagger $ = study from systematic corpus. Val. = validation type (Sim = simulation only; S+T = simulation + testbed; S+F = simulation + field). Val. Type = Multi-agent ($\geq $2 UAVs in validation), Framework-only (multi-UAV framework validated with single agent), or Review. Metrics: T = execution time, E = energy, C = convergence. App.: Mon. = Monitoring, Spr. = Spraying, Map. = Mapping, Gen. = General coordination}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Distribution of swarm intelligence algorithms across 33 reviewed studies (2021--2025). PSO dominates with 10 papers (30.3\% of the full corpus; 38.5\% of the 26 primary research studies), followed by review articles (21.2\%) and ACO variants (9.1\%). ``Other SI Variants'' (5 papers, 15.2\%) includes SFLA, Fuzzy/SIGPAF, Wolf Pack, Hybrid ABC+BAS, and GA+ABC hybrid; PSO+ACO (S06) and APF+PSO (S29) are classified under PSO.}}{22}{figure.2}\protected@file@percent }
\newlabel{fig:algorithms}{{2}{22}{Distribution of swarm intelligence algorithms across 33 reviewed studies (2021--2025). PSO dominates with 10 papers (30.3\% of the full corpus; 38.5\% of the 26 primary research studies), followed by review articles (21.2\%) and ACO variants (9.1\%). ``Other SI Variants'' (5 papers, 15.2\%) includes SFLA, Fuzzy/SIGPAF, Wolf Pack, Hybrid ABC+BAS, and GA+ABC hybrid; PSO+ACO (S06) and APF+PSO (S29) are classified under PSO}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Algorithm and variant frequency across 33 reviewed studies. Percentages reported over full corpus (n=33) and primary studies (n=26). Review articles excluded from algorithm-specific analyses.}}{23}{table.5}\protected@file@percent }
\newlabel{tab:algorithms}{{5}{23}{Algorithm and variant frequency across 33 reviewed studies. Percentages reported over full corpus (n=33) and primary studies (n=26). Review articles excluded from algorithm-specific analyses}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Availability of quantitative metric reporting. Left bars: rates over the full corpus of 33 included studies (n=33). Right bars: rates over the 26 primary research studies (n=26). Only 14 of 33 (42.4\%) report execution time; only 7 of 33 (21.2\%) specify convergence criteria.}}{23}{figure.3}\protected@file@percent }
\newlabel{fig:metrics}{{3}{23}{Availability of quantitative metric reporting. Left bars: rates over the full corpus of 33 included studies (n=33). Right bars: rates over the 26 primary research studies (n=26). Only 14 of 33 (42.4\%) report execution time; only 7 of 33 (21.2\%) specify convergence criteria}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Metric reporting frequency. Rates are reported over the full corpus (n=33) and over primary research studies only (n=26).}}{24}{table.6}\protected@file@percent }
\newlabel{tab:metrics}{{6}{24}{Metric reporting frequency. Rates are reported over the full corpus (n=33) and over primary research studies only (n=26)}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Metric reporting completeness by SI algorithm family across 26 primary research studies (review articles S10, S11, S14, S15, S17, S31, S32 excluded). T = execution time reported; E = energy consumption reported (hardware measurement or simulation estimate; see note below Table~\ref {tab:study_chars}); C = convergence criteria specified. Score\textsubscript  {$\mitmu $} = mean number of metrics reported per study (range 0--3). Cells show count of studies reporting the metric / total in family (\%). All 3 = studies reporting T, E, and C simultaneously. Families with $n \geq 2$ primary studies are listed individually; singleton algorithms are grouped below the dividing rule.}}{24}{table.7}\protected@file@percent }
\newlabel{tab:metrics_by_algo}{{7}{24}{Metric reporting completeness by SI algorithm family across 26 primary research studies (review articles S10, S11, S14, S15, S17, S31, S32 excluded). T = execution time reported; E = energy consumption reported (hardware measurement or simulation estimate; see note below Table~\ref {tab:study_chars}); C = convergence criteria specified. Score\textsubscript {$\mu $} = mean number of metrics reported per study (range 0--3). Cells show count of studies reporting the metric / total in family (\%). All 3 = studies reporting T, E, and C simultaneously. Families with $n \geq 2$ primary studies are listed individually; singleton algorithms are grouped below the dividing rule}{table.7}{}}
