{
  "$schema": "https://opencode.ai/config.json",
  "model": "alibaba/qwen-max",
  "fallback_model": "alibaba/qwen-plus",
  "small_model": "alibaba/qwen-turbo",
  "fallback_models": [
    "alibaba/qwen-max",
    "alibaba/qwen-plus",
    "alibaba/qwen-turbo",
    "alibaba/qwen2.5-vl-72b-instruct",
    "alibaba/qwen2.5-72b-instruct",
    "alibaba/qwen2.5-coder-32b-instruct",
    "alibaba/qwen-long"
  ],
  "mcp": {
    "obsidian": {
      "type": "local",
      "command": ["node", "/home/andres/.local/share/obsidian-mcp/node_modules/obsidian-mcp/build/main.js", "/home/andres/Documentos/ANTIGRAVITY-PROYECTOS"],
      "enabled": true,
      "timeout": 300000
    },
    "duckdb": {
      "type": "local",
      "command": ["uvx", "mcp-server-motherduck", "--db-path", ":memory:", "--read-write", "--allow-switch-databases", "--max-rows", "2000", "--query-timeout", "60"],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": { "Authorization": "Bearer {file:/home/andres/Documentos/ANTIGRAVITY-PROYECTOS/.github_token}" }
    }
  },
  "provider": {
    "ollama": {
      "options": {
        "baseURL": "http://localhost:11434"
      },
      "models": {
        "qwen2.5:1.5b": {
          "name": "qwen2.5:1.5b",
          "tool_call": true,
          "limit": {
            "context": 16000,
            "output": 2048
          }
        }
      }
    }
  },
  "context_limit": {
    "warning_threshold": 0.8,
    "auto_truncate": true,
    "preserve_recent": 10,
    "preserve_oldest": 5
  },
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "pwd": "allow",
      "which *": "allow",
      "echo *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git show*": "allow",
      "rm -rf *": "deny",
      "git push -f*": "deny",
      "git push --force*": "deny"
    }
  },
  "instructions": ["AGENTS.md"]
}
